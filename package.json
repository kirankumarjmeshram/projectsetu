{
  "name": "projectsetu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modular foundation for bankable project reports and deterministic financial calculations.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "npm run db:dev:prepare && npm run dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diff-check": "git diff --check",
    "test": "tsx scripts/run-tests.ts unit",
    "test:watch": "tsx scripts/run-tests.ts watch",
    "test:db": "tsx scripts/run-tests.ts db",
    "test:e2e": "tsx scripts/run-tests.ts e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "db:migrate:status": "npx tsx scripts/migrate-status.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:dev:start": "tsx scripts/dev-db.ts start",
    "db:dev:stop": "tsx scripts/dev-db.ts stop",
    "db:dev:prepare": "tsx scripts/dev-db.ts prepare",
    "db:dev:check": "tsx scripts/dev-db.ts check",
    "test:db:prepare": "tsx scripts/run-tests.ts prepare",
    "test:db:check": "tsx scripts/run-tests.ts check",
    "test:verify": "tsx scripts/run-tests.ts verify",
    "test:infra": "tsx scripts/run-tests.ts infra",
    "test:reports": "tsx scripts/professional-report-qa.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "next": "^16.3.2",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "jszip": "^3.10.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
