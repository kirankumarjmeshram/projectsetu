# ==============================================================================
# ProjectSetu — Production Environment Configuration Template
# ==============================================================================
# Copy this template to .env.local for local development.
# In production, provide these variables securely via secret managers or deployment envs.
# NEVER commit populated .env files containing real secrets to version control.
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_VERSION=0.1.0
PORT=3000

# --- PostgreSQL Persistence ---
# Primary application relational database (PostgreSQL 14+)
# Example format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/projectsetu

# Integration Test Database (used solely by vitest.config.db.ts and CI)
# CAUTION: The test suite executes transactional fixtures and isolated test tables.
# NEVER point TEST_DATABASE_URL to a production database!
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/projectsetu_test

# PostgreSQL Connection Pool Configuration (Optional tuning)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Authentication & Session Security ---
# Secret key used for signing session tokens / cookie verification
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-32-byte-hex-or-base64-secret-here

# Optional: Development/E2E test seed account overrides (NEVER enabled in production)
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=Admin@ExampleTest2026!
DEV_USER_EMAIL=user@example.test
DEV_USER_PASSWORD=User@ExampleTest2026!
ALLOW_DEV_SEED=false

# --- Private Object Storage (Quotations, Project Documents, DPR Artifacts) ---
# When omitted, the application uses local encrypted temporary filesystem storage.
STORAGE_PROVIDER=local
STORAGE_BUCKET=projectsetu-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# --- Observability & Security ---
LOG_LEVEL=info
ENABLE_RATE_LIMIT=true
